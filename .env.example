# The PostgreSQL database, e.g. postgresql://user:password@192.168.0.20:5432/secret_santa
DATABASE_URL=

# Signs the login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# The frontend URLs that may call the API, comma separated
CORS_ORIGINS=https://secret-santa.example.com

# Optional. Creates this admin on startup if there is no admin yet.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional. How long a login lasts, defaults to 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional. DEBUG, INFO, WARNING or ERROR. Defaults to INFO.
LOG_LEVEL=INFO

# Only for docker-compose: the backend's IP address on the br0 network
BACKEND_IP=
